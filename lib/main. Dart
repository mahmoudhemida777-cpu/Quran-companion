class LocaleNotifier extends Notifier<LocaleState> {
  late SharedPreferences _prefs;

  @override
  LocaleState build() {
    _prefs = ref.watch(sharedPreferencesProvider);
    final savedLang = _prefs.getString(AppKeys.langKey) ?? 'ar';
    final savedIsDark = _prefs.getBool(AppKeys.darkModeKey) ?? false;
    return LocaleState(lang: savedLang, isDark: savedIsDark);
  }

  void toggleLanguage(String lang) {
    state = LocaleState(lang: lang, isDark: state.isDark);
    _prefs.setString(AppKeys.langKey, lang);
  }

  void toggleDarkMode(bool isDark) {
    state = LocaleState(lang: state.lang, isDark: isDark);
    _prefs.setBool(AppKeys.darkModeKey, isDark);
  }
}

final localeProvider = NotifierProvider<LocaleNotifier, LocaleState>(LocaleNotifier.new);

class DailyPlanNotifier extends Notifier<DailyPlan> {
  late SharedPreferences _prefs;

  @override
  DailyPlan build() {
    _prefs = ref.watch(sharedPreferencesProvider);
    return _loadOrResetDailyPlan();
  }

  DailyPlan _loadOrResetDailyPlan() {
    final now = DateTime.now();
    final todayStr = "${now.year}-${now.month}-${now.day}";
    final lastSavedDate = _prefs.getString(AppKeys.planLastDateKey);

    final initialPlan = ScheduleService.generateDailyPlan(now, 1.0);

    if (lastSavedDate == todayStr) {
      return initialPlan.copyWith(
        newMemDone: _prefs.getBool(AppKeys.planNewMemDoneKey) ?? false,
        newRevDone: _prefs.getBool(AppKeys.planNewRevDoneKey) ?? false,
        oldRevDone: _prefs.getBool(AppKeys.planOldRevDoneKey) ?? false,
      );
    } else {
      _prefs.setString(AppKeys.planLastDateKey, todayStr);
      _prefs.setBool(AppKeys.planNewMemDoneKey, false);
      _prefs.setBool(AppKeys.planNewRevDoneKey, false);
      _prefs.setBool(AppKeys.planOldRevDoneKey, false);

      return initialPlan;
    }
  }

  void toggleTask(String type) {
    DailyPlan updatedPlan;
    if (type == 'newMem') {
      final updatedVal = !state.newMemDone;
      updatedPlan = state.copyWith(newMemDone: updatedVal);
      _prefs.setBool(AppKeys.planNewMemDoneKey, updatedVal);
    } else if (type == 'newRev') {
      final updatedVal = !state.newRevDone;
      updatedPlan = state.copyWith(newRevDone: updatedVal);
      _prefs.setBool(AppKeys.planNewRevDoneKey, updatedVal);
    } else {
      final updatedVal = !state.oldRevDone;
      updatedPlan = state.copyWith(oldRevDone: updatedVal);
      _prefs.setBool(AppKeys.planOldRevDoneKey, updatedVal);
    }

    state = updatedPlan;
    // مزامنة فورية في خلفية Firestore
    ref.read(authServiceProvider).syncPlanToCloud(updatedPlan);
  }

  void checkAndRefresh() {
    state = _loadOrResetDailyPlan();
  }
}

final dailyPlanProvider = NotifierProvider<DailyPlanNotifier, DailyPlan>(DailyPlanNotifier.new);

