class DailyPlan {
  final DateTime date;
  final String newMemRange;
  final String newRevRange;
  final String oldRevRange;
  final bool newMemDone;
  final bool newRevDone;
  final bool oldRevDone;

  DailyPlan({
    required this.date,
    required this.newMemRange,
    required this.newRevRange,
    required this.oldRevRange,
    this.newMemDone = false,
    this.newRevDone = false,
    this.oldRevDone = false,
  });

  double get completionRate {
    int total = 3;
    int done = 0;
    if (newMemDone) done++;
    if (newRevDone) done++;
    if (oldRevDone) done++;
    return done / total;
  }

  Map<String, dynamic> toFirestore() {
    return {
      'date': "${date.year}-${date.month}-${date.day}",
      'newMemDone': newMemDone,
      'newRevDone': newRevDone,
      'oldRevDone': oldRevDone,
      'completionRate': completionRate,
      'updatedAt': FieldValue.serverTimestamp(),
    };
  }

  DailyPlan copyWith({
    DateTime? date,
    String? newMemRange,
    String? newRevRange,
    String? oldRevRange,
    bool? newMemDone,
    bool? newRevDone,
    bool? oldRevDone,
  }) {
    return DailyPlan(
      date: date ?? this.date,
      newMemRange: newMemRange ?? this.newMemRange,
      newRevRange: newRevRange ?? this.newRevRange,
      oldRevRange: oldRevRange ?? this.oldRevRange,
      newMemDone: newMemDone ?? this.newMemDone,
      newRevDone: newRevDone ?? this.newRevDone,
      oldRevDone: oldRevDone ?? this.oldRevDone,
    );
  }
}

