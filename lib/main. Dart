    const TimeOfDay(hour: 5, minute: 0),
    'تذكير الحفظ اليومي',
    'حان وقت مراجعة وحفظ القرآن الكريم اليوم',
  );

  // 4. تشغيل التطبيق مع Riverpod Overrides
  runApp(
    ProviderScope(
      overrides: [
        sharedPreferencesProvider.overrideWithValue(prefs),
      ],
      child: const QuranCompanionApp(),
    ),
  );
}

class QuranCompanionApp extends ConsumerWidget {
  const QuranCompanionApp({super.key});

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final localeState = ref.watch(localeProvider);

    return MaterialApp(
      title: 'رفيق القرآن',
      debugShowCheckedModeBanner: false,
      locale: localeState.locale,
      themeMode: localeState.isDark ? ThemeMode.dark : ThemeMode.light,
      theme: ThemeData(
        brightness: Brightness.light,
        primarySwatch: Colors.green,
        useMaterial3: true,
      ),
      darkTheme: ThemeData(
        brightness: Brightness.dark,
        primarySwatch: Colors.green,
        useMaterial3: true,
      ),
      home: const MainTabNavigation(),
    );
  }
}
